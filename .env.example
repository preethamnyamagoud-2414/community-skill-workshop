# Copy to .env for local use (never commit .env). On Vercel, set these in
# Project Settings -> Environment Variables instead.

# Required in production: long random string
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Cloud database (TiDB Cloud). Leave DB_HOST empty to use local SQLite.
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=skillconnect_db

# Only used by scripts/init_cloud_db.py to create the admin account
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
